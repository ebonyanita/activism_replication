.groups = "drop") %>%
ggplot(aes(x = period, y = mean_rc, colour = condition, group = condition)) +
geom_vline(xintercept = 7, linetype = "dashed", colour = "grey50") +
geom_line(linewidth = 0.8) +
geom_ribbon(aes(ymin = mean_rc - se_rc, ymax = mean_rc + se_rc, fill = condition),
alpha = 0.15, colour = NA) +
scale_colour_paletteer_d("ggthemes::Tableau_10") +
scale_fill_paletteer_d("ggthemes::Tableau_10") +
annotate("text", x = 3.5, y = Inf, label = "Treatment", vjust = 1.5,
colour = "grey40", size = 3) +
annotate("text", x = 11,  y = Inf, label = "Control",   vjust = 1.5,
colour = "grey40", size = 3) +
labs(title = "Mean Relative Contribution Over Time",
x = "Period", y = "Mean Relative Contribution",
colour = NULL, fill = NULL) +
theme_minimal(base_size = 12) +
xlim(c(1,14))
# Chunk 13: h1 ols
#pure - all groups
model_h1_ols <- lm(relative_contribution ~ condition + period,
data = df_long %>% filter(!is.na(relative_contribution)))
# Cluster-robust SEs at group level
vcov_h1_ols <- vcovCL(model_h1_ols, cluster = ~ group_id)
coeftest(model_h1_ols, vcov = vcov_h1_ols)
tab_model(model_h1_ols)
#v2 with treatment
# Chunk 14: h1 emmeans
emm_h1_ols <- emmeans(model_h1_ols, "condition", vcov. = vcov_h1_ols)
emm_h1_ols
pairs(emm_h1_ols, adjust = "holm")
# Chunk 15: h1-tobit
model_h1_tobit <- tobit(
relative_contribution ~ condition + period,
left  = 0, right = 1,
data  = df_long %>% filter(!is.na(relative_contribution)))
vcov_h1_tobit <- vcovCL(model_h1_tobit, cluster = ~ group_id)
coeftest(model_h1_tobit, vcov = vcov_h1_tobit)
# Chunk 16: h1-tobit-emmeans
emm_h1_tobit <- emmeans(model_h1_tobit, "condition", vcov. = vcov_h1_tobit)
emm_h1_tobit
pairs(emm_h1_tobit, adjust = "holm")
# Chunk 18: h2-data
df_activism <- df_long %>%
filter(
is_treatment_round,
period >= 8,
!is.na(chose_activism),
!is.na(others_contribution_lag),
!is.na(NegDev_lag),
!is.na(PosDev_lag)
)
# Chunk 1: setup
knitr::opts_chunk$set(echo = TRUE, warning = FALSE, message = FALSE)
# Chunk 2: packages
if (!requireNamespace("pacman", quietly = TRUE)) install.packages("pacman")
library(pacman)
library(tidyverse)
library(dplyr)
library(ggpubr)
library(lme4)
library(lmerTest)
library(sandwich)
library(emmeans)
library(sjPlot)
library(ggeffects)
library(ggthemes)
library(report)
library(rempsyc)
library(AER)
library(psych)
library(patchwork)
library(kableExtra)
library(paletteer)
#install.packages("rlang")
# Chunk 3: load-data
df_raw_s1 <- read.csv(
"/Volumes/Crucial 1TB/RESEARCH/1. Data/activism-github/activism/analysis/1.data/raw_s1_all_apps_wide_2026-06-09-2.csv",
header = TRUE, stringsAsFactors = FALSE, na.strings = c("", "NA"))
df_raw_s2 <- read.csv(
"/Volumes/Crucial 1TB/RESEARCH/1. Data/activism-github/activism/analysis/1.data/raw_s2_all_apps_wide-2026-06-09-2.csv",
header = TRUE, stringsAsFactors = FALSE, na.strings = c("", "NA"))
df_raw <- bind_rows(df_raw_s1,df_raw_s2)
# Chunk 4: pivot longer
df_long <- df_raw %>%
# pivot all activism round columns
pivot_longer(
cols      = matches("^activism\\.\\d+\\."),
names_to  = c("app_round", ".value"),
names_pattern = "activism\\.(\\d+)\\.(.*)"
) %>%
dplyr::mutate(app_round = as.integer(app_round))
# Chunk 5: rename & recode
df_long <- df_long %>%
rename(
session_code     = session.code,
participant_id   = participant.id_in_session,
treatment_assigned = participant.treatment,
final_payoff     = participant.payoff, #payoff based on random round selection
selected_round   = participant.selected_round, #round used for payment
id_in_group      = `player.id_in_group`,
#round-level vars
wage             = `player.wage`, #wage for each round
contribution     = `player.contribution`, #contribution per round
round_payoff     = `player.round_payoff`,
effort_score     = `player.effort_score`, #RET performance, # of grids correctly counted
actual_effort_time = `player.actual_effort_time`,
group_raw_id     = `group.id_in_subsession`,
num_activists    = `group.num_activists`, #use for activism participation
num_roadblockers = `group.num_roadblockers`, #s/a activism but RB condition only, drop
round_treatment  = `group.treatment`, #s/a participant treatment, drop
period           = `subsession.round_number`
) %>%
mutate(
# Unique group ID across sessions
group_id = paste(session_code, group_raw_id, sep = "_"),
# Unique participant ID across sessions
participant_uid = paste(session_code, participant_id, sep = "_"),
# Treatment round = has effort task (rounds 1–7)
is_treatment_round = as.numeric(if_else(period <=7,0,1)),
# Condition: treatment type for activism rounds, "Control" otherwise
condition = if_else(is_treatment_round == 1, treatment_assigned, "control"),
condition = factor(condition,
levels = c("control", "petition", "demonstration", "roadblock")),
chose_activism   = if_else(num_activists >0, 1, 0), #activism turnout
# Ensure numeric
contribution   = as.numeric(contribution),
wage           = as.numeric(wage),
chose_activism = as.numeric(chose_activism),
round_payoff   = as.numeric(round_payoff),
# Relative contribution: share of wage contributed (q_it = g_it / y_it)
relative_contribution = if_else(!is.na(wage) & wage > 0,
contribution / wage, NA_real_))
# Chunk 6: pos & neg deviation
df_long <- df_long %>%
group_by(group_id, period) %>%
mutate(
group_mean_contribution = mean(contribution, na.rm = TRUE),
group_size              = sum(!is.na(contribution)),
# Others' mean = (group total - own contribution) / (n - 1)
others_contribution = if_else(group_size > 1 & !is.na(contribution),
((group_mean_contribution * group_size) - contribution) / (group_size - 1),
NA_real_
),
# Absolute deviations from group mean
NegDev = pmax(0, group_mean_contribution - contribution, na.rm = FALSE),
PosDev = pmax(0, contribution - group_mean_contribution, na.rm = FALSE)
) %>%
ungroup() %>%
# Lag variables (for activism regression, available from period t=2)
arrange(participant_uid, period) %>%
group_by(participant_uid) %>%
mutate(
others_contribution_lag = lag(others_contribution),
NegDev_lag              = if_else(period >=8, lag(NegDev),NA_real_),
PosDev_lag              = if_else(period >=8, lag(PosDev),NA_real_),
NegDev_lag_full         = lag(NegDev),
PosDev_lag_full         = lag(PosDev)
) %>%
ungroup()
# Chunk 7: welfare
df_welfare <- df_long %>%
group_by(group_id, period, condition, session_code, treatment_assigned) %>%
summarise(
welfare            = sum(round_payoff, na.rm = TRUE),
mean_contribution  = mean(contribution, na.rm = TRUE),
n_activists        = sum(num_activists, na.rm = TRUE),
.groups            = "drop")
# Chunk 8: questionnaire
df_questionnaire <- df_raw %>%
select(session.code, participant.id_in_session,
matches("^questionnaire\\.1\\.player")) %>%
rename(
session_code   = session.code,
participant_id = participant.id_in_session
) %>%
mutate(participant_uid = paste(session_code, participant_id, sep = "_")) %>%
select(-session_code, -participant_id)
# Participant-level summary (mean across periods, final period, etc.)
df_participant <- df_long %>%
group_by(participant_uid, group_id, session_code, treatment_assigned, condition) %>%
summarise(
mean_relative_contribution = mean(relative_contribution, na.rm = TRUE),
final_relative_contribution = last(relative_contribution[!is.na(relative_contribution)]),
mean_chose_activism = mean(chose_activism[is_treatment_round], na.rm = TRUE),
mean_payoff = mean(round_payoff, na.rm = TRUE),
.groups = "drop"
) %>%
left_join(df_questionnaire, by = "participant_uid")
# Chunk 10: desc-outcomes
# Treatment-period outcome summary
df_long %>%
filter(!is.na(relative_contribution)) %>%
group_by(condition) %>%
summarise(
n              = n(),
mean_rel_contrib = mean(relative_contribution, na.rm = TRUE),
sd_rel_contrib   = sd(relative_contribution, na.rm = TRUE),
mean_activism    = mean(chose_activism, na.rm = TRUE),
mean_payoff      = mean(round_payoff, na.rm = TRUE),
.groups = "drop"
) %>%
kbl(digits = 3, caption = "Outcome means by condition") %>%
kable_styling(bootstrap_options = c("striped", "hover"), full_width = FALSE)
# Chunk 11: plot contributions
df_long %>%
filter(!is.na(relative_contribution)) %>%
ggplot(aes(x = condition, y = relative_contribution, fill = condition)) +
ggdist::stat_halfeye(alpha = 0.7, adjust = 0.8) +
geom_boxplot(width = 0.1, outlier.shape = NA, alpha = 0.4) +
scale_fill_paletteer_d("ggthemes::Tableau_10") +
labs(title = "Relative Contribution by Condition",
x = "Condition", y = "Relative Contribution (g/y)",
fill = NULL) +
theme_minimal(base_size = 12) +
theme(legend.position = "none")
# Chunk 12: plot-time-trends
df_long %>%
filter(!is.na(relative_contribution)) %>%
group_by(period, treatment_assigned) %>%
summarise(mean_rc = mean(relative_contribution, na.rm = TRUE),
se_rc   = sd(relative_contribution, na.rm = TRUE) / sqrt(n()),
.groups = "drop") %>%
ggplot(aes(x = period, y = mean_rc, colour = treatment_assigned, group = treatment_assigned)) +
geom_vline(xintercept = 7, linetype = "dashed", colour = "grey50") +
geom_line(linewidth = 0.8) +
geom_ribbon(aes(ymin = mean_rc - se_rc, ymax = mean_rc + se_rc, fill = treatment_assigned),
alpha = 0.15, colour = NA) +
scale_colour_paletteer_d("ggthemes::Tableau_10") +
scale_fill_paletteer_d("ggthemes::Tableau_10") +
annotate("text", x = 3.5, y = Inf, label = "Treatment", vjust = 1.5,
colour = "grey40", size = 3) +
annotate("text", x = 11,  y = Inf, label = "Control",   vjust = 1.5,
colour = "grey40", size = 3) +
labs(title = "Mean Relative Contribution Over Time",
x = "Period", y = "Mean Relative Contribution",
colour = NULL, fill = NULL) +
theme_minimal(base_size = 12) +
xlim(c(1,14))
df_long %>%
filter(!is.na(relative_contribution)) %>%
group_by(period, condition) %>%
summarise(mean_rc = mean(relative_contribution, na.rm = TRUE),
se_rc   = sd(relative_contribution, na.rm = TRUE) / sqrt(n()),
.groups = "drop") %>%
ggplot(aes(x = period, y = mean_rc, colour = condition, group = condition)) +
geom_vline(xintercept = 7, linetype = "dashed", colour = "grey50") +
geom_line(linewidth = 0.8) +
geom_ribbon(aes(ymin = mean_rc - se_rc, ymax = mean_rc + se_rc, fill = condition),
alpha = 0.15, colour = NA) +
scale_colour_paletteer_d("ggthemes::Tableau_10") +
scale_fill_paletteer_d("ggthemes::Tableau_10") +
annotate("text", x = 3.5, y = Inf, label = "Treatment", vjust = 1.5,
colour = "grey40", size = 3) +
annotate("text", x = 11,  y = Inf, label = "Control",   vjust = 1.5,
colour = "grey40", size = 3) +
labs(title = "Mean Relative Contribution Over Time",
x = "Period", y = "Mean Relative Contribution",
colour = NULL, fill = NULL) +
theme_minimal(base_size = 12) +
xlim(c(1,14))
# Chunk 13: h1 ols
#pure - all groups
model_h1_ols <- lm(relative_contribution ~ condition + period,
data = df_long %>% filter(!is.na(relative_contribution)))
# Cluster-robust SEs at group level
vcov_h1_ols <- vcovCL(model_h1_ols, cluster = ~ group_id)
coeftest(model_h1_ols, vcov = vcov_h1_ols)
tab_model(model_h1_ols)
#v2 with treatment
# Chunk 14: h1 emmeans
emm_h1_ols <- emmeans(model_h1_ols, "condition", vcov. = vcov_h1_ols)
emm_h1_ols
pairs(emm_h1_ols, adjust = "holm")
# Chunk 15: h1-tobit
model_h1_tobit <- tobit(
relative_contribution ~ condition + period,
left  = 0, right = 1,
data  = df_long %>% filter(!is.na(relative_contribution)))
vcov_h1_tobit <- vcovCL(model_h1_tobit, cluster = ~ group_id)
coeftest(model_h1_tobit, vcov = vcov_h1_tobit)
# Chunk 16: h1-tobit-emmeans
emm_h1_tobit <- emmeans(model_h1_tobit, "condition", vcov. = vcov_h1_tobit)
emm_h1_tobit
pairs(emm_h1_tobit, adjust = "holm")
# Chunk 18: h2-data
df_activism <- df_long %>%
filter(
is_treatment_round,
period >= 8,
!is.na(chose_activism),
!is.na(others_contribution_lag),
!is.na(NegDev_lag),
!is.na(PosDev_lag)
)
df_activism <- df_long %>%
filter(
is_treatment_round == 1,
period >= 8,
!is.na(chose_activism),
!is.na(others_contribution_lag),
!is.na(NegDev_lag),
!is.na(PosDev_lag)
)
cat("Observations for activism models:", nrow(df_activism))
# Chunk 19: h2-logit
model_h2_logit <- glm(
chose_activism ~ condition + others_contribution_lag +
NegDev_lag + PosDev_lag + period,
family = binomial(link = "logit"),
data   = df_activism
)
vcov_h2_logit <- vcovCL(model_h2_logit, cluster = ~ group_id)
coeftest(model_h2_logit, vcov = vcov_h2_logit)
# Chunk 20: h2-logit-emmeans
emm_h2_logit <- emmeans(model_h2_logit, "condition",
vcov. = vcov_h2_logit, type = "response")
emm_h2_logit
pairs(emm_h2_logit, adjust = "holm")
# Chunk 21: h2-probit
model_h2_probit <- glm(
chose_activism ~ condition + others_contribution_lag +
NegDev_lag + PosDev_lag + period,
family = binomial(link = "probit"),
data   = df_activism
)
vcov_h2_probit <- vcovCL(model_h2_probit, cluster = ~ group_id)
coeftest(model_h2_probit, vcov = vcov_h2_probit)
# Chunk 22: h2-group-level
df_activism_group <- df_long %>%
filter(is_treatment_round) %>%
group_by(group_id, period, condition) %>%
summarise(
turnout_rate = mean(chose_activism, na.rm = TRUE),
n_activists  = sum(chose_activism, na.rm = TRUE),
group_size   = n(),
.groups      = "drop"
)
# Activism turnout over time (treatment rounds only)
model_trend_activism <- lm(
chose_activism ~ condition * period,
data = df_long %>% filter(is_treatment_round == 1, !is.na(chose_activism))
)
vcov_trend_activism <- vcovCL(model_trend_activism, cluster = ~ group_id)
coeftest(model_trend_activism, vcov = vcov_trend_activism)
# Plot EMMs for H1 (OLS) if model has sufficient data
tryCatch({
emm_df <- as.data.frame(emm_h1_ols) %>%
rename(lower = lower.CL, upper = upper.CL)
ggplot(emm_df, aes(x = condition, y = emmean, colour = condition)) +
geom_point(size = 3) +
geom_errorbar(aes(ymin = lower, ymax = upper), width = 0.2) +
scale_colour_paletteer_d("ggthemes::Tableau_10") +
labs(title = "Estimated Marginal Means: Relative Contribution",
subtitle = "OLS with cluster-robust SEs (clustered by group)",
x = "Condition", y = "EMM Relative Contribution",
colour = NULL) +
theme_minimal(base_size = 12) +
theme(legend.position = "none")
}, error = function(e) message("Insufficient data for EMM plot: ", e$message))
ggplot(emm_df, aes(x = condition, y = emmean, colour = condition)) +
geom_point(size = 3) +
geom_errorbar(aes(ymin = lower, ymax = upper), width = 0.2) +
scale_colour_paletteer_d("ggthemes::Tableau_10") +
labs(title = "Estimated Marginal Means: Relative Contribution",
