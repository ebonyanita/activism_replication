# Chunk 1: setup + set wd
rm(list=ls())
getwd()
#setwd("/Volumes/Crucial 1TB/RESEARCH/1. Data/activism-github/activism/analysis")
knitr::opts_chunk$set(echo = TRUE)
library(here)
knitr::opts_knit$set(root.dir = "../")
options(scipen=999, digits=4)
knitr::opts_chunk$set(echo = TRUE, warning = FALSE, message = FALSE)
# Chunk 2: packages
if (!requireNamespace("pacman", quietly = TRUE)) install.packages("pacman")
#install.packages("rlang")
library(pacman)
library(tidyverse)
library(dplyr)
library(ggpubr)
library(lme4)
library(lmerTest)
library(sandwich)
library(emmeans)
library(sjPlot)
library(ggeffects)
library(ggthemes)
library(report)
library(rempsyc)
library(AER)
library(psych)
library(patchwork)
library(kableExtra)
library(paletteer)
library(interactions)
library(estimatr)
library(ggpubr)
library(effectsize)
library(devtools)
library(fixest)
library(fwildclusterboot)
library(clubSandwich)
library(ggsignif)
report::report_system()
#install.packages("rlang")
# Chunk 3: load data
df_raw_s1 <- read.csv(
"1.data/raw_s1_all_apps_wide_2026-06-09-2.csv",
header = TRUE, stringsAsFactors = FALSE, na.strings = c("", "NA")) #36x258
df_raw_s2 <- read.csv(
"1.data/raw_s2_all_apps_wide-2026-06-09-2.csv",
header = TRUE, stringsAsFactors = FALSE, na.strings = c("", "NA")) #28x272
df_wide <- bind_rows(df_raw_s1,df_raw_s2)
#due to technical errors with the game several participants weren't able to complete the survey (we include logged responses in analysis and as a robustness check, check if results differ without these groups)
#group.total_contribution missing from session 2 data so s2 has more columns
# Chunk 4: missing data removal + exploration
#remove demo sessions
df_wide <- df_wide %>%
filter(session.is_demo == 0) %>%
mutate(pct_complete = rowMeans(!is.na(.)) * 100)
summary(df_wide$pct_complete)
#create clean version
df_clean <- df_wide %>%
filter(!is.na(questionnaire.1.player.q3_personal_cost))
table(df_wide$participant.treatment) #16+24+16
table(df_clean$participant.treatment) #12+16+8; mostly roadblock data lost; lost 1 demo group + 2 petition groups + 2 RB groups
df_clean %>%
count(participant.treatment,activism.1.group.id_in_subsession,session.code) #9 groups that completed experiment, 5 didn't (in rounds 46&8); final sample has 2-4 groups/condition
# Chunk 5: pivot longer
df_long <- df_wide %>%
# pivot all activism round columns
pivot_longer(
cols      = matches("^activism\\.\\d+\\."),
names_to  = c("app_round", ".value"),
names_pattern = "activism\\.(\\d+)\\.(.*)"
) %>%
dplyr::mutate(app_round = as.integer(app_round))
# Chunk 6: rename & recode - main dvs
df_long <- df_long %>%
rename(
session_code     = session.code,
participant_id   = participant.id_in_session,
treatment_assigned = participant.treatment,
final_payoff     = participant.payoff, #payoff based on random round selection
selected_round   = participant.selected_round, #round used for payment
id_in_group      = `player.id_in_group`,
#round-level vars
wage             = `player.wage`, #wage for each round
contribution     = `player.contribution`, #contribution per round
round_payoff     = `player.round_payoff`, #how much each player earned in that round
effort_score     = `player.effort_score`, #RET performance, # of grids correctly counted
actual_effort_time = `player.actual_effort_time`, #time for RET; 45 secs + impacted by activism decisions (so could be 35 or 40)
group_raw_id     = `group.id_in_subsession`,
num_activists    = `group.num_activists`, #number of activists in group; use for activism participation
num_roadblockers = `group.num_roadblockers`, #s/a activism but RB condition only, drop
round_treatment  = `group.treatment`, #s/a participant treatment, drop
period           = `subsession.round_number`
) %>%
mutate(
# Unique group ID across sessions
app_round_2 = if_else(app_round >7, app_round -7,app_round),
group_id = paste(session_code, group_raw_id, sep = "_"),
participant_seat = if_else(session_code == "ahosr93r",paste(participant.label,"1", sep = "_"),
if_else(session_code == "tdmddbpq",paste(participant.label,"2", sep = "_"),"")),
# Treatment round if activism (rounds 8-14)
is_treatment_round = as.numeric(if_else(period <=7,0,1)),
# Condition: treatment type for activism rounds, "Control" otherwise
condition = if_else(is_treatment_round == 1, treatment_assigned, "control"),
condition = factor(condition,
levels = c("control", "petition", "demonstration", "roadblock")),
# activism engagement
activism_rate  = if_else(is_treatment_round == 1, (num_activists/4) * 100, NA), #activism turnout % (main activism dv)
chose_activism = if_else(num_activists > 0, 1, 0), #if individual chose activism or not (binary)
# Ensure numeric
contribution   = as.numeric(contribution),
wage           = as.numeric(wage),
chose_activism = as.numeric(chose_activism),
round_payoff   = as.numeric(round_payoff),
# relative contribution: share of wage contributed (q_it = g_it / y_it)
relative_contribution = if_else(!is.na(wage) & wage > 0,
(contribution / wage) * 100, NA_real_),
# payoff vars accounting for variation in time spent on RET
norm_wage = wage / actual_effort_time,
norm_payoff = round_payoff / actual_effort_time) %>%
select(-(c(participant.visited:participant.mturk_assignment_id,session.label:session.treatment,
player.role,questionnaire.1.player.role,
group.total_contribution,player.payoff))) #remove irrel/blank columns
# Chunk 7: pos & neg deviation & adl cals
#Following Fehr & Gächter (2000): compute others' mean contribution and positive/negative deviations from the group mean, then lag by one period.
df_long <- df_long %>%
group_by(group_id, period) %>%
mutate(
group_mean_contribution  = mean(contribution, na.rm = TRUE),#points contributed to pg
group_total_contribution = if_else(is.na(contribution),NA,
sum(contribution, na.rm = TRUE)),
group_size               = if_else(is.na(contribution),NA,
sum(!is.na(contribution))),
# Others' mean = (group total - own contribution) / (n - 1) - TO FIX SO IT ACTUALLY USES GROUP TOTAL INSTEAD OF MEAN
others_contribution = if_else(group_size > 1 & !is.na(contribution),
((group_mean_contribution * group_size) - contribution) / (group_size - 1), NA_real_),
#group-level vars; same for each individual in group for that round
total_wage             = if_else(is.na(wage),NA,
sum(wage, na.rm = TRUE)), #total individual earnings per group pooled
welfare                = if_else(is.na(round_payoff),NA,
sum(round_payoff, na.rm = TRUE)), #payoff post-contribution pooled
norm_welfare           = if_else(is.na(round_payoff),NA,
sum(round_payoff, na.rm = TRUE) / actual_effort_time), #welfare per sec to account for time loss in costly activism conditions
welfare_fullcoop       = if_else(is.na(round_payoff),NA,
sum(wage, na.rm = TRUE) * 1.6), #welfare if everyone gave everything
n_activists            = if_else(is.na(round_payoff),NA,
sum(num_activists, na.rm = TRUE)),
n_freeriders           = if_else(is.na(contribution),NA,
sum(contribution == 0, na.rm = TRUE)),
#efficiency = group earnings / earnings with full cooperation
efficiency             = if_else(!(is.na(round_payoff)),
(welfare / welfare_fullcoop) * 100, NA_real_),
# Absolute deviations from group mean
NegDev = pmax(0, group_mean_contribution - contribution, na.rm = FALSE),
PosDev = pmax(0, contribution - group_mean_contribution, na.rm = FALSE)
) %>%
ungroup() %>%
# Lag variables (for activism regression, available from period t=8)
arrange(participant.code, period) %>%
group_by(participant.code) %>%
mutate(
others_contribution_lag = lag(others_contribution),
NegDev_lag              = if_else(period >=8, lag(NegDev),NA_real_),
PosDev_lag              = if_else(period >=8, lag(PosDev),NA_real_),
NegDev_lag_full         = lag(NegDev),
PosDev_lag_full         = lag(PosDev)) %>%
ungroup() %>%
filter(group_size == 4) #for participants that didn't finish experiment, removing where group size = 3 since that's the round where experiment stopped working for the group
df_long_clean <- df_long %>%
filter(!is.na(questionnaire.1.player.q3_personal_cost))
#do welfare & efficiency at group level only? repeated for each individual within group
describe(df_long)
# Chunk 8: questionnaire + participant-level data
#questionnaire data only - TO DO: clean all var names
df_questionnaire <- df_wide %>%
select(session.code, participant.id_in_session,participant.treatment,
matches("^questionnaire\\.1\\.player")) %>%
rename(session_code   = session.code,
participant_id = participant.id_in_session) %>%
mutate(participant.code = paste(session_code, participant_id, sep = "_")) %>%
select(-session_code, -participant_id)
head(df_questionnaire)
#participant-level summary (mean across periods, final period, etc. - 2 rows per participant)
df_participant <- df_long %>%
group_by(participant.code, group_id, session_code, treatment_assigned,condition,is_treatment_round) %>%
summarise(
mean_relative_contribution      = mean(relative_contribution, na.rm = TRUE),
mean_control_contribution       = mean(relative_contribution[period <= 7], na.rm = TRUE),
mean_treatment_contribution     = mean(relative_contribution[period > 7], na.rm = TRUE),
final_relative_contribution     = last(relative_contribution[!is.na(relative_contribution)]),
mean_num_activism               = mean(num_activists, na.rm = TRUE),
mean_payoff                     = mean(round_payoff, na.rm = TRUE),
.groups = "drop"
) %>%
left_join(df_questionnaire, by = "participant.code")
head(df_participant)
# Chunk 9: save
#save as RData
save(df_wide, df_clean,
df_long,df_long_clean,
df_participant,df_questionnaire,
file = "1.data/clean/clean_dfs.RData")
write.csv(df_long,"1.data/clean/df_long.csv")
# Chunk 10: desc outcomes
#outcomes by condition
df_long %>%
filter(!is.na(relative_contribution)) %>%
group_by(treatment_assigned,is_treatment_round) %>%
summarise(
n                = n(),
"Avg Contribution %" = mean(relative_contribution, na.rm = TRUE),
"Avg Contribution % (SD)"   = sd(relative_contribution, na.rm = TRUE),
"Chose Activism"  = mean(chose_activism, na.rm = TRUE),
"Avg # of Activists"    = mean(num_activists, na.rm = TRUE),
"Avg Payoff"      = mean(round_payoff, na.rm = TRUE),
"Avg Wage" = mean(wage, na.rm = TRUE),
"Avg Norm Wage" = mean(norm_wage, na.rm = TRUE),
"Avg Welfare" = mean(welfare, na.rm = TRUE),
"Avg Efficiency" = mean(efficiency, na.rm = TRUE),
.groups = "drop"
) %>%
kbl(digits = 3, caption = "Outcome means by condition") %>%
kable_styling(bootstrap_options = c("striped", "hover"), full_width = FALSE)
unique(df_long$group_id)
# Chunk 11: questionnaire summary by condition
#describeBy(df_questionnaire,group = "participant.treatment")
library(gtsummary)
df_questionnaire %>%
tbl_summary(include = c(questionnaire.1.player.q1_support:questionnaire.1.player.q8_annoyance),
by = participant.treatment,
type = list(all_continuous() ~ "continuous2",
c(questionnaire.1.player.q3_personal_cost:questionnaire.1.player.q8_annoyance
) ~ "continuous2"),
statistic = list(all_continuous() ~ c("{mean} ({sd})","{median} [{min},{max}]"),
all_categorical() ~ "{n} ({p}%)"),
#sort = list(everything() ~ "frequency"),
digits = list(all_continuous() ~ 2,
all_categorical() ~ 2)) %>%
add_n() %>% # add column with total number of non-missing observations
add_overall() %>%
add_p(pvalue_fun = ~ style_pvalue(.x, digits = 2))
# Chunk 12: color palette
# Derive named colors from Tableau_10: roadblock=blue[1], petition=orange[2], demonstration=red[3]
.tab10 <- paletteer::paletteer_d("ggthemes::Tableau_10")
condition_colors <- c(
"control"       = "gray40",
"petition"      = as.character(.tab10[2]),
"demonstration" = as.character(.tab10[3]),
"roadblock"     = as.character(.tab10[1])
)
treatment_colors <- c(
"petition"      = as.character(.tab10[2]),
"demonstration" = as.character(.tab10[3]),
"roadblock"     = as.character(.tab10[1])
)
table(df_long$treatment_assigned)
df_long$treatment_assigned = relevel(as.factor(df_long$treatment_assigned),"demonstration")
# Chunk 13: h1 ols & emmeans
#1. OLS; main preregisted model - all groups
model_h1_ols <- lm(relative_contribution ~ condition + period,
data = df_long %>% filter(!is.na(relative_contribution)))
# Cluster-robust SEs at group level
vcov_h1_ols <- vcovCL(model_h1_ols, cluster = ~ group_id)
coeftest(model_h1_ols, vcov = vcov_h1_ols)
plot_model(model_h1_ols,
show.values=T,show.p=T,  sort.est = T,#colors = condition_colors,
bpe.style = "dot", value.offset = .2,dot.size = 3,#mdrt.values ="meansd",
jitter = 1, value.size = 3,line.size = .5) + theme_classic()
#cleaner version but slightly more conservative results (look more at SE types in this version)
model_h1_ols_rob <- estimatr::lm_robust(relative_contribution ~ condition + period,
data = df_long %>% filter(!is.na(relative_contribution)),
clusters = group_id,
se_type = "CR2")
tab_model(model_h1_ols_rob)
interact_plot(model_h1b_ols, pred = "is_treatment_round",modx = "treatment_assigned",
#plot.points = T,
#rug = T,jitter = .1,
#interval = T,
robust = T,line.thickness = 2,int.type = "confidence",
colors = c("#F28E2BFF", "#E15759FF","#4E79A7FF")) +
theme_classic()
interact_plot(model_h1_ols, pred = "is_treatment_round",modx = "treatment_assigned",
#plot.points = T,
#rug = T,jitter = .1,
#interval = T,
robust = T,line.thickness = 2,int.type = "confidence",
colors = c("#F28E2BFF", "#E15759FF","#4E79A7FF")) +
theme_classic()
#v2 with treatment_assigned instead of condition
model_h1b_ols <- lm(relative_contribution ~ treatment_assigned * is_treatment_round + period,
data = df_long %>% filter(!is.na(relative_contribution)))
vcov_h1b_ols <- vcovCL(model_h1b_ols, cluster = ~ group_id)
coeftest(model_h1b_ols, vcov = vcov_h1b_ols)
interact_plot(model_h1b_ols, pred = "is_treatment_round",modx = "treatment_assigned",
#plot.points = T,
